# ========================================================
# JLU Gießen Accounting Tutor — Environment Variables
# Trage diese Variablen in der Vercel-Konsole ein:
# Vercel -> Project Settings -> Environment Variables
# ========================================================

# 1. Google Gemini API Keys (Komma-separiert für automatische Rotation bei Quota-Limits)
GEMINI_API_KEY="your-gemini-key-placeholder"
GEMINI_API_KEYS="your-gemini-key-1,your-gemini-key-2,your-gemini-key-3,your-gemini-key-4,your-gemini-key-5"

# 2. OpenRouter API Keys (Backup-Provider falls Google Quota überschritten wird)
OPENROUTER_API_KEY="your-openrouter-key-placeholder"
OPENROUTER_API_KEYS="your-openrouter-key-1,your-openrouter-key-2,your-openrouter-key-3,your-openrouter-key-4,your-openrouter-key-5"
